# Copy to .env.local to use.

# Optional: protect the admin UI with a login page.
# Strongly recommended anywhere other than your own machine.
# Leave ADMIN_PASSWORD empty to disable. /api/verify always stays public.
# Quote values containing # or $, and escape literal $ as \$ (Next expands env values).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional: secret used to sign login sessions (falls back to ADMIN_PASSWORD).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Required: PostgreSQL connection string (Neon: use the pooled "postgresql://..." URL).
# Never commit the real value. Quote it if the password contains # or $.
DATABASE_URL=
